# 複製為 .env 並填入實際值；.env 不會被提交進版本控制（見 .gitignore）。

# Google Gemini API 金鑰。後端呼叫 Gemini API 時使用，缺少時伺服器啟動會直接拒絕啟動。
GEMINI_API_KEY=

# Pollinations.ai Secret API 金鑰（sk_ 開頭）。後端 /api/dream-image 代理端點用來
# 呼叫 gen.pollinations.ai 的 flux 圖片模型，缺少時伺服器啟動會直接拒絕啟動。
# 這把金鑰只能存在後端，絕對不能加上 VITE_ 前綴讓前端讀到。
POLLINATIONS_API_KEY=

# 後端 Express 伺服器監聽的埠號，未設定時預設 3001。
PORT=3001
